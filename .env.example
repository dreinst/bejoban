DATABASE_URL="file:./data/bejoban.db"
SESSION_SECRET="ganti-dengan-string-acak-64-karakter"
UPLOAD_DIR="./data/uploads"
# Alamat publik situs, tanpa garis miring di akhir. Dipakai untuk tautan pendek yang disalin ke bio dan balasan
# sosial media. Kosong = alamat dari header permintaan (bisa berupa IP kalau admin dibuka lewat IP).
SITE_URL=

# Worker chatbot stok (scripts/bot-wa.ts). Isi nilainya hanya di .env lokal.
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=
# Kosong = uji kering (hanya mencetak balasan). Isi 1 untuk benar-benar mengirim.
BOT_SEND=
BOT_POLL_SEC=
BOT_MAX_AGE_MIN=

# Pencarian lokasi ongkir. Kosong = OpenStreetMap (Nominatim) tanpa kunci.
GOOGLE_MAPS_API_KEY=
