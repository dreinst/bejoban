generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  name            String
  instagram       String    @default("")
  whatsapp        String    @default("")
  address         String    @default("")
  hours           String    @default("08.00 sampai 17.00")
  mapsUrl         String    @default("")
  photo           String    @default("")
  services        String    @default("")
  sort            Int       @default(0)
  listings        Listing[]
  users           User[]
  // Kasir (docs/KASIR.md). kode_nota: awalan nomor transaksi, mis. BTU. mode_stok: sheet (bawaan) atau kasir.
  kodeNota        String?   @unique @map("kode_nota")
  modeStok        String    @default("sheet") @map("mode_stok")
  kasirAktifSejak DateTime? @map("kasir_aktif_sejak")
}

model User {
  id           Int     @id @default(autoincrement())
  username     String  @unique
  name         String  @default("")
  passwordHash String
  role         String  @default("BRANCH_ADMIN") // OWNER | BRANCH_ADMIN
  branchId     Int?
  aktif        Boolean @default(true) @map("aktif") // false: tidak bisa login dan sesi lamanya tidak berlaku
  branch       Branch? @relation(fields: [branchId], references: [id])
}

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  image     String    @default("")
  sort      Int       @default(0)
  tipe      String    @default("barang") @map("tipe") // barang | jasa
  pakaiStok Boolean   @default(true) @map("pakai_stok")
  aktif     Boolean   @default(true) @map("aktif")
  products  Product[]
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  logo     String    @default("")
  sort     Int       @default(0)
  byOrder  Boolean   @default(false) @map("by_order") // true: tidak distok, dipesan dulu ke distributor
  aktif    Boolean   @default(true) @map("aktif") // false: tidak tampil di situs, pilihan merek produk, dan kosakata by order bot
  products Product[]
}

model Product {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  spec        String    @default("")
  description String    @default("")
  fitment     String    @default("")
  images      String    @default("[]")
  isSample    Boolean   @default(false)
  active      Boolean   @default(true)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  brandId     Int?
  brand       Brand?    @relation(fields: [brandId], references: [id])
  listings    Listing[]
  kode        String?   @unique @map("kode") // kode produk gaya BejoStock; kosong: slug dipakai sebagai cadangan
  ukuran      String?   @map("ukuran")
  hargaAcuan  Int?      @map("harga_acuan")
  barcode     String?   @map("barcode")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Listing {
  id           Int     @id @default(autoincrement())
  productId    Int
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId     Int
  branch       Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  price        Int     @default(0)
  comparePrice Int     @default(0)
  stock        Int     @default(0)
  available    Boolean @default(true)
  flashSale    Boolean @default(false)
  batasMinimum Int?    @map("batas_minimum") // kosong: tanpa peringatan stok menipis. Diatur owner.

  @@unique([productId, branchId])
}

model Setting {
  key   String @id
  value String
}

// Stok ban hasil impor pricelist (data internal, tidak tampil di toko).
model StockTire {
  id           Int       @id @default(autoincrement())
  groupName    String    @default("") // judul kelompok di pricelist, mis. "R13 (Muatan + MT)"
  ring         Int       @default(0)
  sizeRaw      String
  sizeNorm     String // untuk pencarian, mis. "185/65R15"
  brand        String    @default("") // merek dan model apa adanya dari pricelist
  price        Int? // null kalau kosong atau formatnya janggal
  stock        Int       @default(0)
  note         String    @default("")
  discount     Int       @default(0) // potongan dari keterangan "disc <angka>"; price tetap harga asli
  priceIssue   String    @default("") // alasan harga kosong atau janggal, dari impor
  manual       Boolean   @default(false) // diubah manual di tabel stok
  lockManual   Boolean   @default(true) // true: sinkron berikutnya tidak menimpa baris ini
  manualAt     DateTime?
  importedAt   DateTime  @default(now())
  // Kode stabil "ukuran|merek" (src/lib/stok/kode.ts). Kosong hanya sebelum scripts/isi-kode-stok.ts
  // atau impor pertama sesudah migrasi. PostgreSQL mengizinkan banyak NULL pada indeks unik.
  kode         String?   @map("kode")
  aktif        Boolean   @default(true) @map("aktif") // false: hilang dari sumber pricelist, diabaikan semua pembaca
  // Cabang pemilik baris stok. null: baris lama yang belum ditetapkan cabangnya (dianggap stok bersama).
  // Sengaja tanpa relasi (seperti buku_stok.cabang_id) supaya migrasinya cukup ADD COLUMN tanpa membangun ulang tabel.
  cabangId     Int?      @map("cabang_id")
  batasMinimum Int?      @map("batas_minimum") // kosong: tanpa peringatan stok menipis. Diatur owner.

  // Kode unik per cabang. Untuk baris tanpa cabang (cabang_id NULL) PostgreSQL menganggap NULL selalu berbeda,
  // jadi migrasi dasar 20261120000000_postgres_dasar menambah indeks unik parsial StockTire_kode_tanpa_cabang_key
  // (kode WHERE cabang_id IS NULL) langsung di SQL. Prisma belum bisa menuliskan indeks parsial di skema.
  @@unique([kode, cabangId])
  @@index([cabangId])
  @@index([sizeNorm])
  @@index([ring])
}

// Tarif ekspedisi per kota, diisi admin dari daftar harga agen.
model ShippingRate {
  id        Int      @id @default(autoincrement())
  carrier   String // JNT_CARGO | BARAKA
  city      String
  perKg     Int
  minWeight Float    @default(10)
  etaDays   String   @default("")
  note      String   @default("")
  isSample  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([carrier, city])
}

// Pesan WhatsApp yang sudah diproses worker, supaya tidak dibalas dua kali.
model BotProcessed {
  messageId String   @id
  createdAt DateTime @default(now())
}

// Log uji dan log balasan worker.
model BotLog {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  source         String // UJI | WA_KERING | WA
  sender         String   @default("")
  input          String
  reply          String
  handoff        Boolean  @default(false)
  sent           Boolean  @default(false)
  reason         String   @default("")
  conversationId Int?
}

// Percakapan chatbot per pelanggan. Status: BARU, DIJAWAB_BOT, DISERAHKAN, SELESAI_ADA, SELESAI_TIDAK_ADA.
model BotConversation {
  id               Int       @id @default(autoincrement())
  channel          String    @default("WA")
  chatId           String // id chat WAHA, dipakai untuk membalas
  customer         String    @default("") // nomor pelanggan (angka saja)
  branchSlug       String    @default("")
  status           String    @default("BARU")
  question         String    @default("") // pesan terakhir yang memicu status
  sizes            String    @default("") // ukuran yang ditanya, dipisah koma
  result           String    @default("") // ringkasan hasil pencarian
  mutedUntil       DateTime? // bot diam di chat ini sampai waktu ini
  closingPending   Boolean   @default(false) // penutup "tidak tersedia" belum terkirim
  lastOutOfHoursAt DateTime?
  awaitingBranch   Boolean   @default(false) // bot sedang menunggu jawaban 1 atau 2 untuk cabang
  pendingAction    String    @default("") // serah | ganti | stok, tindakan yang menunggu jawaban cabang
  pendingText      String    @default("") // pesan asal yang menunggu jawaban cabang
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([chatId, status])
  @@index([status])
}

// Harga jasa (spooring, balance, nitrogen, dan lain-lain). Tidak tampil di situs publik.
model ServicePrice {
  id          Int    @id @default(autoincrement())
  groupName   String // mis. "Spooring", dipakai untuk mengelompokkan
  name        String // nama baris, mis. "Spooring"
  variant     String @default("") // mis. "R12 sampai R15"
  ringMin     Int?
  ringMax     Int?
  minDiameter Int? // mis. 31 untuk "ban 31 ke atas"
  price       Int? // null kalau belum diisi
  unit        String @default("") // mis. "per roda"
  altLabel    String @default("") // mis. "paket"
  altPrice    Int?
  note        String @default("")
  keywords    String @default("") // kata kunci pencarian, dipisah koma
  sort        Int    @default(0)
}

// Cache hasil pencarian lokasi (OpenStreetMap atau penyedia lain).
model GeoCache {
  id        Int      @id @default(autoincrement())
  provider  String
  query     String
  results   String // JSON array Place
  createdAt DateTime @default(now())

  @@unique([provider, query])
}

// Cabang pilihan pelanggan, diingat per nomor selama jangka waktu yang bisa diatur.
model BotBranchChoice {
  customer   String   @id
  branchSlug String
  chosenAt   DateTime @default(now())
}

// Hitungan klik tautan pendek /wa per cabang per hari. Tanpa data pribadi.
model WaClick {
  day    String // YYYY-MM-DD, waktu Jakarta
  branch String // slug cabang, kosong untuk tautan umum /wa
  count  Int    @default(0)

  @@id([day, branch])
}

// ---- Penyelarasan dengan BejoStock (nama tabel dan kolom mengikuti ERD Asah) ----

// Buku stok: satu baris untuk tiap perubahan stok. Ditulis hanya lewat src/lib/stok.
// tipe: jual | masuk | opname | transfer | void | impor | koreksi (divalidasi di kode).
// cabang_id sengaja tanpa relasi supaya riwayat tetap ada walau cabang dihapus.
model BukuStok {
  id         Int      @id @default(autoincrement())
  tipe       String
  perubahan  Int
  saldoAkhir Int      @map("saldo_akhir")
  refId      String?  @map("ref_id")
  batchId    Int?     @map("batch_id")
  cabangId   Int?     @map("cabang_id") // cabang baris stok; null untuk stok ban tanpa cabang
  kodeProduk String   @map("kode_produk") // kode StockTire, atau kode Product (slug kalau kode kosong)
  waktu      DateTime @default(now())
  pengguna   String? // id pengguna sebagai teks, kosong untuk proses otomatis

  @@index([kodeProduk])
  @@index([waktu])
  @@map("buku_stok")
}

// Jejak aksi admin yang mengubah data. data berisi ringkasan kecil dalam JSON, bukan seluruh isi.
model LogAktivitas {
  id       Int      @id @default(autoincrement())
  pengguna String?
  aksi     String
  entitas  String
  data     String   @default("{}")
  waktu    DateTime @default(now())

  @@index([waktu])
  @@map("log_aktivitas")
}

// Hari libur dan promo. tanggal berupa teks YYYY-MM-DD (waktu Jakarta), sama seperti WaClick.day.
model Kalender {
  id         Int    @id @default(autoincrement())
  tanggal    String
  jenis      String // libur | promo | lainnya
  keterangan String @default("")

  @@index([tanggal])
  @@map("kalender")
}

// ---- Kasir v1 (docs/KASIR.md). Nama tabel dan kolom mengikuti ERD BejoStock, bedanya dicatat di dokumen itu. ----
// Uang dalam rupiah bulat (Int). cabang_id dan pengguna_id sengaja tanpa relasi, sama seperti buku_stok,
// supaya riwayat tetap ada walau akun dihapus. nama_kasir menyimpan salinan nama saat transaksi.

// Kepala transaksi kasir. status: selesai | void. channel: toko | whatsapp. metode_bayar: tunai | qris | debit.
model Transaksi {
  id             Int               @id @default(autoincrement())
  nomor          String            @unique
  cabangId       Int               @map("cabang_id")
  penggunaId     Int               @map("pengguna_id")
  namaKasir      String            @default("") @map("nama_kasir")
  channel        String
  metodeBayar    String            @map("metode_bayar")
  subtotal       Int
  diskon         Int               @default(0)
  alasanDiskon   String            @default("") @map("alasan_diskon")
  total          Int
  dibayar        Int?
  kembalian      Int?
  status         String            @default("selesai")
  alasanVoid     String?           @map("alasan_void")
  divoidOleh     Int?              @map("divoid_oleh")
  waktuVoid      DateTime?         @map("waktu_void")
  idempotencyKey String            @unique @map("idempotency_key")
  waktuTransaksi DateTime          @default(now()) @map("waktu_transaksi")
  detail         DetailTransaksi[]

  @@index([cabangId, waktuTransaksi])
  @@index([waktuTransaksi])
  @@map("transaksi")
}

// Baris nota, satu per batch. sumber: ban | produk | jasa. baris_id: id StockTire (ban) atau Listing (produk), kosong untuk jasa.
// subtotal = jumlah x harga_satuan (sebelum diskon). diskon: bagian diskon nota untuk baris ini.
model DetailTransaksi {
  id               Int        @id @default(autoincrement())
  transaksiId      Int        @map("transaksi_id")
  transaksi        Transaksi  @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  sumber           String
  kodeProduk       String     @map("kode_produk")
  barisId          Int?       @map("baris_id")
  nama             String
  jumlah           Int
  hargaSatuan      Int        @map("harga_satuan")
  hargaAsli        Int        @map("harga_asli")
  diskon           Int        @default(0)
  subtotal         Int
  batchId          Int?       @map("batch_id")
  batch            BatchStok? @relation(fields: [batchId], references: [id])
  pengajuanHargaId Int?       @map("pengajuan_harga_id")

  @@index([transaksiId])
  @@index([batchId])
  @@map("detail_transaksi")
}

// Batch stok per baris stok cabang. Penjualan mengambil batch tertua yang masih bersisa (tanggal_masuk, lalu id).
// jenis: awal (saat kasir diaktifkan) | koreksi | masuk dan opname (bagian 2).
model BatchStok {
  id                  Int               @id @default(autoincrement())
  sumber              String
  kodeProduk          String            @map("kode_produk")
  barisId             Int               @map("baris_id")
  cabangId            Int               @map("cabang_id")
  jenis               String
  detailBarangMasukId Int?              @map("detail_barang_masuk_id")
  hargaBeli           Int?              @map("harga_beli")
  hargaJual           Int               @map("harga_jual")
  jumlahAwal          Int               @map("jumlah_awal")
  sisa                Int
  tanggalMasuk        DateTime          @default(now()) @map("tanggal_masuk")
  detail              DetailTransaksi[]

  @@index([sumber, barisId, tanggalMasuk])
  @@index([cabangId])
  @@map("batch_stok")
}

// Pengajuan harga. tipe: diskon (diskon nota dari admin) | restock (bagian 2).
// status: menunggu | disetujui | ditolak | batal (transaksinya di-void sebelum ditinjau).
model PengajuanHarga {
  id                Int       @id @default(autoincrement())
  tipe              String
  cabangId          Int       @map("cabang_id")
  sumber            String?
  kodeProduk        String?   @map("kode_produk")
  pengajuId         Int       @map("pengaju_id")
  hargaLama         Int       @map("harga_lama")
  hargaBaru         Int       @map("harga_baru")
  alasan            String    @default("")
  status            String    @default("menunggu")
  penyetujuId       Int?      @map("penyetuju_id")
  diputuskan        DateTime?
  batchId           Int?      @map("batch_id")
  detailTransaksiId Int?      @map("detail_transaksi_id")
  transaksiId       Int?      @map("transaksi_id")
  dibuat            DateTime  @default(now())

  @@index([status, dibuat])
  @@index([transaksiId])
  @@map("pengajuan_harga")
}

// Riwayat harga jual batch. harga_lama kosong untuk harga pertama.
model RiwayatHarga {
  id           Int      @id @default(autoincrement())
  sumber       String
  kodeProduk   String   @map("kode_produk")
  cabangId     Int      @map("cabang_id")
  batchId      Int?     @map("batch_id")
  hargaLama    Int?     @map("harga_lama")
  harga        Int
  pengguna     String?
  berlakuMulai DateTime @default(now()) @map("berlaku_mulai")

  @@index([sumber, kodeProduk, cabangId])
  @@map("riwayat_harga")
}

// Peringatan stok menipis per baris stok (pengganti stok_cabang_id di ERD). status: aktif | ditutup.
model PeringatanStok {
  id            Int       @id @default(autoincrement())
  sumber        String
  barisId       Int       @map("baris_id")
  kodeProduk    String    @map("kode_produk")
  cabangId      Int?      @map("cabang_id")
  jumlahSaatItu Int       @map("jumlah_saat_itu")
  batasMinimum  Int       @map("batas_minimum")
  status        String    @default("aktif")
  dibuat        DateTime  @default(now())
  ditutup       DateTime?

  @@index([status])
  @@index([sumber, barisId, status])
  @@map("peringatan_stok")
}

// Penghitung nomor transaksi per cabang per hari WIB (tanggal: YYMMDD). Dinaikkan dengan satu UPSERT supaya aman bersamaan.
model PenghitungNota {
  cabangId Int    @map("cabang_id")
  tanggal  String
  nomor    Int    @default(0)

  @@id([cabangId, tanggal])
  @@map("penghitung_nota")
}

// Kasir bagian 2 (docs/KASIR.md): barang masuk, opname. Nama tabel dan kolom mengikuti ERD Asah.
// cabang_id dan pengguna_id sengaja tanpa relasi, sama seperti tabel kasir bagian 1.
model BarangMasuk {
  id              Int                 @id @default(autoincrement())
  nomorPenerimaan String              @unique @map("nomor_penerimaan")
  cabangId        Int                 @map("cabang_id")
  pemasok         String
  jenisPemasok    String              @map("jenis_pemasok") // distributor atau rekanan
  tanggalPesan    DateTime?           @map("tanggal_pesan") // pukul 00.00 WIB tanggal itu
  tanggalTerima   DateTime            @map("tanggal_terima") // pukul 00.00 WIB tanggal itu
  penggunaId      Int                 @map("pengguna_id")
  namaPengguna    String              @map("nama_pengguna")
  catatan         String              @default("")
  idempotencyKey  String              @unique @map("idempotency_key")
  dibuat          DateTime            @default(now())
  detail          DetailBarangMasuk[]

  @@index([cabangId, tanggalTerima])
  @@index([tanggalTerima])
  @@map("barang_masuk")
}

model DetailBarangMasuk {
  id               Int         @id @default(autoincrement())
  barangMasukId    Int         @map("barang_masuk_id")
  barangMasuk      BarangMasuk @relation(fields: [barangMasukId], references: [id])
  sumber           String // ban atau produk
  kodeProduk       String      @map("kode_produk")
  barisId          Int         @map("baris_id")
  cabangId         Int         @map("cabang_id")
  nama             String
  jumlah           Int
  hargaBeli        Int?        @map("harga_beli")
  hargaJual        Int         @map("harga_jual") // harga jual yang diisi pencatat (usulan)
  hargaLama        Int         @map("harga_lama") // harga batch terdepan saat dicatat
  batchId          Int?        @map("batch_id")
  pengajuanHargaId Int?        @map("pengajuan_harga_id")

  @@index([barangMasukId])
  @@index([sumber, barisId])
  @@map("detail_barang_masuk")
}

model PenghitungPenerimaan {
  cabangId Int    @map("cabang_id")
  tanggal  String
  nomor    Int    @default(0)

  @@id([cabangId, tanggal])
  @@map("penghitung_penerimaan")
}

model StokOpname {
  id            Int            @id @default(autoincrement())
  cabangId      Int            @map("cabang_id")
  penginputId   Int            @map("penginput_id")
  namaPenginput String         @map("nama_penginput")
  status        String         @default("draft") // draft, review, final
  tanggal       DateTime       @default(now())
  catatan       String         @default("")
  dikirim       DateTime? // masuk review
  finalisatorId Int?           @map("finalisator_id")
  difinalkan    DateTime?
  detail        DetailOpname[]

  @@index([cabangId, status])
  @@map("stok_opname")
}

model DetailOpname {
  id            Int        @id @default(autoincrement())
  opnameId      Int        @map("opname_id")
  opname        StokOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  sumber        String // ban atau produk
  kodeProduk    String     @map("kode_produk")
  barisId       Int        @map("baris_id")
  nama          String
  stokSistem    Int        @map("stok_sistem") // stok sistem saat baris diisi
  stokFisik     Int        @map("stok_fisik")
  selisih       Int
  alasanSelisih String     @default("") @map("alasan_selisih")
  diisi         DateTime   @default(now())
  stokSaatFinal Int?       @map("stok_saat_final") // stok sistem saat finalisasi, sebelum selisih diterapkan
  stokAkhir     Int?       @map("stok_akhir") // stok sesudah selisih diterapkan

  @@unique([opnameId, sumber, barisId])
  @@map("detail_opname")
}
