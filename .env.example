# PostgreSQL 18. Lokal: container Docker di docs/POSTGRES.md. Sandi hanya ditulis di .env lokal.
DATABASE_URL="postgresql://bejoban:ganti-sandi@127.0.0.1:55432/bejoban"
# Server PostgreSQL untuk npm test. Tiap berkas tes membuat basis data sementara bernama acak lalu menghapusnya.
# Kosong = server dari DATABASE_URL (basis data dev-nya sendiri tidak dibuka).
TEST_DATABASE_URL=
# Batas koneksi per proses. Kosong = 5 untuk app, 2 untuk worker bot:wa.
DB_POOL_MAX=
SESSION_SECRET="ganti-dengan-string-acak-64-karakter"
UPLOAD_DIR="./data/uploads"
# Alamat publik situs, tanpa garis miring di akhir. Dipakai untuk tautan pendek yang disalin ke bio dan balasan
# sosial media. Kosong = alamat dari header permintaan (bisa berupa IP kalau admin dibuka lewat IP).
SITE_URL=

# Worker chatbot stok (scripts/bot-wa.ts) dan tombol Tarik riwayat di Cermin chat (app). Isi nilainya hanya di .env lokal.
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=
# Kosong = uji kering (hanya mencetak balasan). Isi 1 untuk benar-benar mengirim.
BOT_SEND=
BOT_POLL_SEC=
BOT_MAX_AGE_MIN=
# Cermin chat: kunci HMAC webhook WAHA (sama dengan hmac.key di konfigurasi webhook sesi). Kosong = webhook menolak semua.
WAHA_WEBHOOK_HMAC=

# Pencarian lokasi ongkir. Kosong = OpenStreetMap (Nominatim) tanpa kunci.
GOOGLE_MAPS_API_KEY=
